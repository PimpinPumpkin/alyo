<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Used for exactly one thing: downloading speech models. Nothing is ever uploaded. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- So the app can see which other voice typing apps are turned on, and say so. -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
        <!-- The in-app reader binds to Alyo's own speech engine. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AlyoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Alyo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!--
            One icon, "Alyo". With the recorder turned on it opens the recordings; otherwise it
            opens the front page. A second icon named "Recorder" is there for anyone who wants
            the two apart: it starts disabled and a switch in Settings enables it, after which
            "Alyo" goes back to opening the front page.
        -->
        <activity-alias
            android:name=".Launcher"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".RecorderLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_recorder"
            android:roundIcon="@mipmap/ic_recorder"
            android:label="@string/recorder_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            "Transcribe" in the share sheet, for audio and video files sent from other apps. Part
            of the recorder: disabled here and enabled with it.
        -->
        <activity-alias
            android:name=".ShareToRecorder"
            android:enabled="false"
            android:exported="true"
            android:label="@string/share_transcribe"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity-alias>

        <!-- The keyboard. Voice only: other keyboards' microphone keys switch to it. -->
        <service
            android:name=".ime.AlyoIme"
            android:enabled="false"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Speech recognition for apps that ask Android for it without showing a keyboard. -->
        <service
            android:name=".recognition.AlyoRecognitionService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition" />
        </service>

        <!-- The same, for apps that ask for the standard speech prompt. -->
        <activity
            android:name=".recognition.RecognizeActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Alyo.Sheet">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The phone's voice: Android hands text to this when Alyo is the chosen speech engine. -->
        <service
            android:name=".tts.AlyoTtsService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <!-- Three questions Android asks every speech engine. None of these shows a screen. -->
        <activity
            android:name=".tts.CheckVoiceData"
            android:enabled="false"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".tts.InstallVoiceData"
            android:enabled="false"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".tts.SampleText"
            android:enabled="false"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Read aloud" in the menu for selected text, and as a place to share text to. -->
        <activity
            android:name=".tts.ReadAloudActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/read_aloud"
            android:taskAffinity=""
            android:theme="@style/Theme.Alyo.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Quick settings tile: one tap from the shade to start or stop recording. -->
        <service
            android:name=".service.RecordTile"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_stat_alyo"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".service.RecordWidget"
            android:enabled="false"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/record_widget" />
        </receiver>

        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The library as a location in the system file picker. Only the system can talk to it. -->
        <provider
            android:name=".export.LibraryProvider"
            android:authorities="${applicationId}.library"
            android:enabled="false"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
